# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fiber_boq

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Google Maps (SERVER key only — Geocoding API + Directions API enabled,
# restricted by server IP in Google Cloud Console. Never expose this key
# to the frontend.)
GOOGLE_MAPS_SERVER_KEY=your-server-side-google-maps-api-key

# CORS
FRONTEND_URL=http://localhost:3000

LOCATIONIQ_API_KEY=your-token-here