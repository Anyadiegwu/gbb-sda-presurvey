DEFAULT_ADMIN_EMAIL=your-admin-email
DEFAULT_ADMIN_PASSWORD=your-admin-password

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fiber_boq

# Auth
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=your-jwt-algorithm
JWT_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:3000

LOCATIONIQ_API_KEY=your-token-here

# Geocoding (free key: https://locationiq.com/register)
GEOCODE_COUNTRY_CODES=ng

# Road routing. The public OSRM demo is for light testing only; point this at
# your own OSRM server (or an OSRM-compatible service) for real traffic.
OSRM_BASE_URL=https://router.project-osrm.org
