<file path="app/integrations/google_maps.py">
"""
Thin wrapper around the Google Maps server-side APIs.

Uses GOOGLE_MAPS_SERVER_KEY only — this key must be restricted (in Google
Cloud Console) to your backend server's IP address, with Geocoding API and
Distance Matrix API and Directions API enabled. Never expose this key to
the frontend/browser.
"""

from typing import List, Optional, Tuple

import googlemaps

from app.core.config import GOOGLE_MAPS_SERVER_KEY


class GoogleMapsError(Exception):
    pass


def _client() -> googlemaps.Client:
    if not GOOGLE_MAPS_SERVER_KEY:
        raise GoogleMapsError(
            "GOOGLE_MAPS_SERVER_KEY is not set. Add it to your .env file."
        )
    return googlemaps.Client(key=GOOGLE_MAPS_SERVER_KEY)


def geocode_address(address: str) -> Tuple[float, float, str]:
    """Returns (latitude, longitude, formatted_address)."""
    client = _client()
    results = client.geocode(address)
    if not results:
        raise GoogleMapsError(f"Could not geocode address: {address!r}")

    location = results[0]["geometry"]["location"]
    formatted_address = results[0].get("formatted_address", address)
    return location["lat"], location["lng"], formatted_address


def get_distances_to_candidates(
    origin: Tuple[float, float], destinations: List[Tuple[float, float]]
) -> List[Optional[float]]:
    """
    One Distance Matrix API call covering every candidate manhole, so we
    only spend a single request no matter how many candidates we shortlist.
    Returns distance in meters per destination, in the same order as the
    input list. A destination Google couldn't route to is returned as None.
    """
    client = _client()
    result = client.distance_matrix(
        origins=[origin],
        destinations=destinations,
        mode="driving",
    )
    elements = result["rows"][0]["elements"]

    distances: List[Optional[float]] = []
    for element in elements:
        if element.get("status") == "OK":
            distances.append(element["distance"]["value"])  # meters
        else:
            distances.append(None)
    return distances


def get_route_polyline(
    origin: Tuple[float, float], destination: Tuple[float, float]
) -> Optional[str]:
    """
    One Directions API call for just the winning candidate, to get the
    encoded polyline for drawing the route on a map. Returns None if no
    route is found (distance/BOQ can still proceed without a polyline).
    """
    client = _client()
    routes = client.directions(origin=origin, destination=destination, mode="driving")
    if not routes:
        return None
    return routes[0]["overview_polyline"]["points"]
